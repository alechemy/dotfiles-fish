index 0000000000000000000000000000000000000000..ef4756b6fe9a61fdd0418a87e01a6f80372ad63f
--- /dev/null
+++ b/src/agent_reader/extractors/pi.py
@@ -0,0 +1,135 @@
+from __future__ import annotations
+
+import json
+from collections.abc import Iterator
+from datetime import datetime, timezone
+from pathlib import Path
+
+from ..models import Session, Turn, parse_ts
+
+DEFAULT = Path.home() / ".pi" / "agent" / "sessions"
+
+
+def discover(root: Path = DEFAULT) -> list[Session]:
+    sessions: list[Session] = []
+    if not root.exists():
+        return sessions
+    for path in sorted(root.rglob("*.jsonl")):
+        session = _session_from_file(path)
+        if session is not None:
+            sessions.append(session)
+    return sessions
+
+
+def turns(session: Session) -> list[Turn]:
+    result: list[Turn] = []
+    current: Turn | None = None
+    for entry in _active_branch(session.path):
+        if entry.get("type") != "message":
+            continue
+        message = entry.get("message") or {}
+        role = message.get("role")
+        if role == "user":
+            prompt = _text_content(message.get("content"))
+            if not prompt:
+                continue
+            current = Turn(
+                index=len(result),
+                prompt=prompt,
+                blocks=[],
+                timestamp=parse_ts(entry.get("timestamp")),
+            )
+            result.append(current)
+        elif role == "assistant" and current is not None:
+            for block in message.get("content") or []:
+                if isinstance(block, dict) and block.get("type") == "text":
+                    text = block.get("text")
+                    if text:
+                        current.blocks.append(text)
+            if current.model is None and message.get("model"):
+                current.model = message["model"]
+            if current.provider is None and message.get("provider"):
+                current.provider = message["provider"]
+    return result
+
+
+def _session_from_file(path: Path) -> Session | None:
+    entries = list(_load(path))
+    header = next((entry for entry in entries if entry.get("type") == "session"), None)
+    if header is None or not header.get("id"):
+        return None
+    cwd = header.get("cwd")
+    name = None
+    for entry in _active_branch_entries(entries):
+        if entry.get("type") == "session_info" and entry.get("name"):
+            name = entry["name"]
+    return Session(
+        cli="pi",
+        id=header["id"],
+        path=path,
+        cwd=cwd,
+        last_activity=datetime.fromtimestamp(path.stat().st_mtime, tz=timezone.utc),
+        label=name or (Path(cwd).name if cwd else header["id"]),
+        name=name,
+    )
+
+
+def _text_content(content: object) -> str:
+    if isinstance(content, str):
+        return content
+    if not isinstance(content, list):
+        return ""
+    parts = [
+        block.get("text", "")
+        for block in content
+        if isinstance(block, dict) and block.get("type") == "text"
+    ]
+    return "\n".join(part for part in parts if part)
+
+
+def _active_branch(path: Path) -> list[dict]:
+    return _active_branch_entries(list(_load(path)))
+
+
+def _active_branch_entries(entries: list[dict]) -> list[dict]:
+    by_id = {
+        entry["id"]: entry
+        for entry in entries
+        if entry.get("type") != "session" and isinstance(entry.get("id"), str)
+    }
+    if not by_id:
+        return []
+    current = next(
+        (
+            entry
+            for entry in reversed(entries)
+            if entry.get("type") != "session" and entry.get("id") in by_id
+        ),
+        None,
+    )
+    branch: list[dict] = []
+    seen: set[str] = set()
+    while current is not None and current["id"] not in seen:
+        branch.append(current)
+        seen.add(current["id"])
+        current = by_id.get(current.get("parentId"))
+    branch.reverse()
+    return branch
+
+
+def _load(path: Path) -> Iterator[dict]:
+    try:
+        handle = path.open("r", encoding="utf-8")
+    except OSError:
+        return
+    with handle:
+        for line in handle:
+            line = line.strip()
+            if not line:
+                continue
+            try:
+                obj = json.loads(line)
+            except ValueError:
+                continue
+            if isinstance(obj, dict):
+                yield obj
