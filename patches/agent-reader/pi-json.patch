+from __future__ import annotations
+
+from agent_reader.extractors import pi
+
+from .conftest import PI_SESSION_ID
+
+
+def test_discover_one_session(pi_root):
+    sessions = pi.discover(pi_root)
+    assert len(sessions) == 1
+    session = sessions[0]
+    assert session.cli == "pi"
+    assert session.id == PI_SESSION_ID
+    assert session.cwd == "/Users/example/projects/widgetapp"
+    assert session.name == "Widget launch review"
+    assert session.label == "Widget launch review"
+
+
+def test_turn_segmentation_and_metadata(pi_root):
+    session = pi.discover(pi_root)[0]
+    turns = pi.turns(session)
+    assert len(turns) == 2
+
+    first, second = turns
+    assert first.prompt == "Review the widget launch path."
+    assert first.blocks == [
+        "I am tracing registration through first render.",
+        "The launch path now initializes only the requested widget.",
+    ]
+    assert first.provider == "openai-codex"
+    assert first.model == "gpt-5.6-sol"
+    assert first.timestamp is not None
+
+    assert second.prompt == "Which provider handled that review?"
+    assert second.final_block == "OpenAI Codex handled both turns."
+    assert second.provider == "openai-codex"
+
+
+def test_abandoned_branch_and_nonprose_blocks_excluded(pi_root):
+    session = pi.discover(pi_root)[0]
+    all_text = "\n".join(block for turn in pi.turns(session) for block in turn.blocks)
+    assert "abandoned branch" not in all_text
+    assert "Private reasoning" not in all_text
+    assert "Synthetic tool output" not in all_text
+
+
+def test_malformed_line_tolerated(pi_root):
+    session = pi.discover(pi_root)[0]
+    assert len(pi.turns(session)) == 2
+
+
+def test_missing_root_is_empty(tmp_path):
+    assert pi.discover(tmp_path / "nope") == []
