#!/bin/bash
# Lint-fix a markdown file in place.
#
# Normalizes tabs and runs markdownlint with DEVONthink-specific prose
# rules for Extract: Native Text Bypass → lint-markdown.applescript.
# Programmatic record creators (the SingleFile
# ingester, GitHub Stars importer, etc.) call this BEFORE
# handing the file to DT so the resulting record arrives fully lint-fixed
# and can be pre-flagged with Recognized=1, Commented=1 — which keeps
# Extract: Native Text Bypass from matching the new record and firing a
# mutation storm on it while DT's UI is still rendering the new arrival.
#
# Usage:
#   lint-markdown-file <path-to-markdown>
#
# Unfixable lint violations return 0. Invalid inputs, missing rules, and
# formatter execution errors return nonzero.

set -eu

if [[ $# -lt 1 ]]; then
    echo "Usage: lint-markdown-file <path-to-markdown>" >&2
    exit 2
fi

path=$1
if [[ ! -f "$path" ]]; then
    echo "lint-markdown-file: not a file: $path" >&2
    exit 2
fi

rules="$HOME/.config/dt-pipeline/markdownlint-rules.cjs"
if [[ ! -r "$rules" ]]; then
    echo "lint-markdown-file: missing rules: $rules" >&2
    exit 2
fi

sed -i '' 's/\t/  /g' "$path"

/opt/homebrew/bin/markdownlint --quiet --fix --rules "$rules" --enable DT001 -- "$path" || {
    status=$?
    if [[ $status -ne 1 ]]; then
        exit "$status"
    fi
}
