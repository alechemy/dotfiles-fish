{
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "defaultProjectTrust": "ask",
  "enableInstallTelemetry": false,
  "hideThinkingBlock": true,
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "transcript",
  "npmCommand": ["npm", "--ignore-scripts"],
  "packages": [
    "npm:@upstash/context7-pi",
    "./local/provider-local-delegation-fff-8a0e972/node_modules/pi-subagents",
    "npm:pi-web-access",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:@sting8k/pi-vcc",
    { "source": "npm:pi-cmux", "extensions": [] },
    "npm:pi-autoresearch",
    "npm:pi-agent-browser-native",
    "npm:@ff-labs/pi-fff"
  ],
  "enabledModels": [
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-luna",
    "github-copilot/claude-opus-5",
    "github-copilot/gpt-6-astra",
    "omlx/Qwen3.8-27B-oQ4e-mtp"
  ],
  "subagents": {
    "worktreeProvider": "worktrunk",
    "defaultExtensions": ["~/.pi/agent/extensions/copilot-guard"],
    "modelScope": {
      "allow": ["inherit-provider"],
      "enforce": true,
      "strict": true,
      "localDelegation": {
        "rootProviders": ["github-copilot", "openai-codex"],
        "agents": {
          "scout": ["omlx/Qwen3.8-27B-oQ4e-mtp"],
          "local-editor": ["omlx/Qwen3.8-27B-oQ4e-mtp"]
        }
      }
    },
