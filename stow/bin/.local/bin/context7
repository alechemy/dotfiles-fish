#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage:
  context7 search <library-name> <query>
  context7 docs <library-id> <query>
EOF
}

if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    usage
    exit 0
fi

command -v curl >/dev/null 2>&1 || { echo "context7: curl is required" >&2; exit 1; }
command -v jq >/dev/null 2>&1 || { echo "context7: jq is required" >&2; exit 1; }

command_name="$1"
shift
base_url="${CONTEXT7_API_URL:-https://context7.com/api}"
headers=(
    --header "X-Context7-Source: cli"
    --header "User-Agent: dotfiles-context7-cli/1"
)
if [[ -n "${CONTEXT7_API_KEY:-}" ]]; then
    headers+=(--header "Authorization: Bearer ${CONTEXT7_API_KEY}")
fi

case "$command_name" in
    search)
        [[ $# -ge 2 ]] || { usage >&2; exit 2; }
        library_name="$1"
        shift
        query="$*"
        curl --fail-with-body --silent --show-error --max-time 60 --get \
            "${headers[@]}" \
            --data-urlencode "libraryName=$library_name" \
            --data-urlencode "query=$query" \
            "$base_url/v2/libs/search" \
            | jq '{
                results: [(.results // [])[] | {
                    id,
                    title,
                    description,
                    totalSnippets,
                    trustScore,
                    benchmarkScore,
                    versions,
                    source
                }],
                searchFilterApplied,
                error
            }'
        ;;
    docs)
        [[ $# -ge 2 ]] || { usage >&2; exit 2; }
        library_id="$1"
        shift
        query="$*"
        [[ "$library_id" == /* ]] || {
            echo "context7: library id must start with /" >&2
            exit 2
        }
        curl --fail-with-body --silent --show-error --max-time 60 --get \
            "${headers[@]}" \
            --data-urlencode "libraryId=$library_id" \
            --data-urlencode "query=$query" \
            "$base_url/v2/context"
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
