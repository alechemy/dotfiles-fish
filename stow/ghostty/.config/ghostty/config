command = /opt/homebrew/bin/fish -l -c 'exec herdr'
font-family = Operator Mono SSm Lig
font-size = 14.0
background-opacity = 1.0
background-blur = true
alpha-blending = linear-corrected
theme = Catppuccin Macchiato
cursor-style = bar
cursor-style-blink = false
adjust-cursor-thickness = 1
macos-icon = retro
shell-integration-features = no-cursor
macos-window-shadow = false
macos-option-as-alt = true
macos-titlebar-style = tabs
keybind = cmd+enter=text:\x1b[13;9u
keybind = shift+enter=text:\x1b[13;2u
keybind = cmd+t=text:\x1b[116;9u
keybind = cmd+shift+t=text:\x1b[116;10u
keybind = cmd+d=text:\x1b[100;9u
keybind = cmd+shift+d=text:\x1b[100;10u
keybind = cmd+shift+h=text:\x1b[104;10u
keybind = cmd+shift+j=text:\x1b[106;10u
keybind = cmd+shift+k=text:\x1b[107;10u
keybind = cmd+shift+l=text:\x1b[108;10u
keybind = cmd+w=close_window
keybind = cmd+alt+w=text:\x1b[119;11u
keybind = cmd+shift+enter=text:\x1b[13;10u
keybind = cmd+shift+left_bracket=text:\x1b[91;10u
keybind = cmd+shift+right_bracket=text:\x1b[93;10u
keybind = cmd+ctrl+n=text:\x1b[110;13u
keybind = cmd+ctrl+w=text:\x1b[119;13u
keybind = cmd+1=text:\x1b[49;9u
keybind = cmd+2=text:\x1b[50;9u
keybind = cmd+3=text:\x1b[51;9u
keybind = cmd+4=text:\x1b[52;9u
keybind = cmd+5=text:\x1b[53;9u
keybind = cmd+6=text:\x1b[54;9u
keybind = cmd+7=text:\x1b[55;9u
keybind = cmd+8=text:\x1b[56;9u
keybind = cmd+9=text:\x1b[57;9u
keybind = cmd+digit_1=text:\x1b[49;9u
keybind = cmd+digit_2=text:\x1b[50;9u
keybind = cmd+digit_3=text:\x1b[51;9u
keybind = cmd+digit_4=text:\x1b[52;9u
keybind = cmd+digit_5=text:\x1b[53;9u
keybind = cmd+digit_6=text:\x1b[54;9u
keybind = cmd+digit_7=text:\x1b[55;9u
keybind = cmd+digit_8=text:\x1b[56;9u
keybind = cmd+digit_9=text:\x1b[57;9u
keybind = global:cmd+ctrl+alt+shift+t=toggle_quick_terminal
quick-terminal-position = right
clipboard-paste-protection = false
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 10s
auto-update = off
mouse-scroll-multiplier = discrete:1
