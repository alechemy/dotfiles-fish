#!/usr/bin/env python3

import argparse
import os
from pathlib import Path
import subprocess
import sys
import termios


SOCKET_NAME = "pi-mobile"
SESSION_LABEL = (
    "#{window_name} | #{?@pi_mobile_cwd,#{@pi_mobile_cwd},#{pane_current_path}} | "
    "#{session_windows} window(s) | #{?session_attached,attached,detached}"
)


def mobile_environment(environment):
    return {
        key: value for key, value in environment.items()
        if not key.startswith("CMUX_")
        and key not in {"TERM_PROGRAM", "TERM_PROGRAM_VERSION", "GHOSTTY_RESOURCES_DIR", "GHOSTTY_BIN_DIR"}
    }


def run_pi(environment):
    if not environment.get("TMUX") or not environment.get("TMUX_PANE"):
        raise ValueError("The internal Pi command must run inside tmux.")
    extension = Path.home() / ".config/pi-mobile/mobile.ts"
    if not extension.is_file():
        raise ValueError("Missing mobile extension. Restow pi-mobile from the primary dotfiles checkout.")
    attributes = termios.tcgetattr(sys.stdin.fileno())
    attributes[0] &= ~termios.IXON
    termios.tcsetattr(sys.stdin.fileno(), termios.TCSANOW, attributes)
    environment["PI_MOBILE"] = "1"
    os.execvpe("pi", ["pi", "--extension", str(extension), "--resume"], environment)


def list_mobile_sessions(tmux, environment):
    result = subprocess.run(tmux + ["list-sessions", "-F", "#{session_id}"],
                            env=environment, text=True, capture_output=True, check=False)
    if result.returncode:
        if "no server running on " in result.stderr or "(No such file or directory)" in result.stderr:
            return []
        raise ValueError(result.stderr.strip() or "Unable to list mobile sessions.")
    sessions = []
    for identifier in result.stdout.splitlines():
        if not identifier.startswith("$") or not identifier[1:].isdigit():
            raise ValueError("Unexpected mobile session identifier.")
        label = subprocess.run(tmux + ["display-message", "-p", "-t", identifier, SESSION_LABEL],
                               env=environment, text=True, capture_output=True, check=False)
        if label.returncode == 0:
            text = "".join(character if character.isprintable() else " " for character in label.stdout.strip())
            sessions.append((identifier, text))
    return sessions


def choose_mobile_session(sessions):
    for number, (_, label) in enumerate(sessions, 1):
        print(f"{number}. {label}")
    while True:
        try:
            choice = input("Reconnect to session number (Enter to cancel): ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return None
        if not choice or choice.lower() == "q":
            return None
        if choice.isdecimal() and 1 <= int(choice) <= len(sessions):
            return sessions[int(choice) - 1][0]
        print(f"Choose a number from 1 to {len(sessions)}, or press Enter to cancel.")


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="Open Pi's picker in the current directory in an independent mobile tmux session.",
        epilog="Quit Pi on the other device first. Ctrl+B then D detaches; Ctrl+B then R opens another picker.",
    )
    parser.add_argument("action", nargs="?", choices=["attach", "resume", "list", "_run"], default="resume",
                        help="resume opens a new session (default); attach shows a reconnect menu; list shows running sessions")
    args = parser.parse_args(argv)
    environment = mobile_environment(os.environ)
    if args.action == "_run":
        if not sys.stdin.isatty() or not sys.stdout.isatty():
            raise ValueError("Pi mobile requires an interactive terminal.")
        run_pi(environment)
        return 0
    if os.environ.get("CMUX_SURFACE_ID"):
        raise ValueError("Use pi-mobile from Termius or a non-cmux terminal. Desktop Pi stays in cmux.")
    if os.environ.get("TMUX"):
        raise ValueError("Already inside tmux. Use Ctrl+B then R for a picker, or detach before running pi-mobile.")
    config = Path.home() / ".config/tmux/pi-mobile.conf"
    if not config.is_file():
        raise ValueError("Missing mobile tmux config. Restow pi-mobile from the primary dotfiles checkout.")
    tmux = ["tmux", "-L", SOCKET_NAME, "-f", str(config)]
    if args.action != "list" and (not sys.stdin.isatty() or not sys.stdout.isatty()):
        raise ValueError("Pi mobile requires an interactive terminal.")
    if args.action in {"attach", "list"}:
        sessions = list_mobile_sessions(tmux, environment)
        if not sessions:
            print("No running mobile sessions. Run pi-mobile to open a picker.")
        elif args.action == "list":
            for number, (_, label) in enumerate(sessions, 1):
                print(f"{number}. {label}")
        else:
            selected = choose_mobile_session(sessions)
            if selected:
                os.execvpe("tmux", tmux + ["attach-session", "-t", selected], environment)
        return 0
    launch = [sys.executable, str(Path(__file__).resolve()), "_run"]
    os.execvpe("tmux", tmux + ["new-session", "-n", "resume", "-c", str(Path.cwd())] + launch, environment)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, subprocess.CalledProcessError, termios.error) as error:
        print(f"pi-mobile: {error}", file=sys.stderr)
        sys.exit(1)
